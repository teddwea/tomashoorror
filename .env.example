# Copy this file to .env and adjust the values.

# By setting EULA=TRUE you agree to the Minecraft EULA:
# https://aka.ms/MinecraftEULA
EULA=TRUE

# Port published on the host. Change this if 25565 is already used.
SERVER_PORT=25565

# Java memory (heap) for the server. Give the container more RAM than MEMORY.
INIT_MEMORY=1G
MEMORY=4G

# RCON (used for admin commands, keep the port internal).
# Leave empty to disable RCON. Set a strong password to enable it.
RCON_PASSWORD=change-this-to-something-secure

# Timezone
TZ=UTC
